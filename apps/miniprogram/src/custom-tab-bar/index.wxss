.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding-bottom: calc(8rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  pointer-events: auto;
}

.tab-capsule {
  width: 704rpx;
  height: 108rpx;
  padding: 9rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 0 0 1rpx rgba(214, 228, 255, 0.92),
    0 18rpx 48rpx rgba(11, 31, 77, 0.16);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  pointer-events: auto;
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
}

.tab-capsule.dragging {
  box-shadow:
    inset 0 0 0 1rpx rgba(190, 213, 255, 0.95),
    0 22rpx 56rpx rgba(30, 77, 255, 0.2);
}

.tab-item {
  flex: 1;
  width: 0;
  height: 90rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  color: #7a879a;
  font-size: 22rpx;
  font-weight: 700;
  transition:
    background-color 180ms ease,
    color 180ms ease,
    box-shadow 180ms ease,
    transform 180ms ease;
}

.tab-item.active {
  background: rgba(231, 239, 255, 0.98);
  color: #1e4dff;
  box-shadow:
    inset 0 0 0 1rpx rgba(180, 207, 255, 0.72),
    0 10rpx 24rpx rgba(30, 77, 255, 0.16);
  transform: translateY(-1rpx);
}

.tab-icon-box {
  width: 34rpx;
  height: 34rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.tab-icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

.tab-text {
  line-height: 1;
  white-space: nowrap;
}
