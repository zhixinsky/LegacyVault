.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 30rpx;
  z-index: 10000;
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding-bottom: 0;
  pointer-events: auto;
}

.tab-capsule {
  width: 690rpx;
  height: 96rpx;
  padding: 7rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 0 0 1rpx rgba(218, 226, 236, 0.92),
    0 10rpx 30rpx rgba(15, 23, 42, 0.12);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  pointer-events: auto;
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
}

.tab-capsule.dragging {
  box-shadow:
    inset 0 0 0 1rpx rgba(190, 213, 255, 0.95),
    0 14rpx 34rpx rgba(30, 77, 255, 0.16);
}

.tab-item {
  flex: 1;
  width: 0;
  height: 82rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7a879a;
  font-size: 19rpx;
  font-weight: 600;
  transition:
    background-color 180ms ease,
    color 180ms ease,
    box-shadow 180ms ease,
    transform 180ms ease;
}

.tab-item.active {
  background: rgba(238, 244, 255, 0.98);
  color: #1e4dff;
  box-shadow:
    inset 0 0 0 1rpx rgba(190, 213, 255, 0.68),
    0 6rpx 16rpx rgba(30, 77, 255, 0.12);
  transform: translateY(-1rpx);
}

.tab-icon-box {
  width: 34rpx;
  height: 34rpx;
  margin-right: 0;
  margin-bottom: 5rpx;
  flex-shrink: 0;
}

.tab-icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

.tab-text {
  line-height: 1;
  white-space: nowrap;
}
