.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding-bottom: calc(18rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  pointer-events: auto;
}

.tab-shell.hidden {
  display: none !important;
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
}

.tab-capsule {
  width: 690rpx;
  height: 88rpx;
  padding: 6rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow:
    inset 0 0 0 1rpx rgba(214, 228, 255, 0.92),
    0 16rpx 42rpx rgba(11, 31, 77, 0.14);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  pointer-events: auto;
}

.tab-item {
  flex: 1;
  width: 0;
  height: 76rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  color: #7a879a;
  font-size: 22rpx;
  font-weight: 700;
}

.tab-item.active {
  background: rgba(231, 239, 255, 0.96);
  color: #1e4dff;
}

.tab-icon-box {
  width: 30rpx;
  height: 30rpx;
  margin-right: 7rpx;
  flex-shrink: 0;
}

.tab-icon {
  display: block;
  width: 30rpx;
  height: 30rpx;
}

.tab-text {
  line-height: 1;
  white-space: nowrap;
}
